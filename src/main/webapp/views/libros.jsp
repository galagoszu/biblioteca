<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="es"><head><title>Catálogo // UNTEC</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="partials/nav.jspf" %><main class="page"><header class="page-header compact"><p class="eyebrow">LIBRARY INDEX / 02</p><h1>Catálogo de libros</h1><form class="search" method="get"><input name="q" value="${param.q}" placeholder="Buscar por título, autor o género"><button class="button button-primary" type="submit">BUSCAR</button></form></header><c:if test="${param.ok eq 'saved'}"><div class="alert success">Libro guardado correctamente.</div></c:if><c:if test="${param.ok eq 'deleted'}"><div class="alert success">Libro eliminado.</div></c:if><c:if test="${param.error eq 'active'}"><div class="alert error">No se puede eliminar un libro con préstamo activo.</div></c:if><c:if test="${param.error eq 'inactive'}"><div class="alert error">Tu cuenta está desactivada. No puedes solicitar nuevos préstamos.</div></c:if><section class="book-grid"><c:choose><c:when test="${empty libros}"><div class="panel empty">No hay libros que coincidan con la búsqueda.</div></c:when><c:otherwise><c:forEach var="libro" items="${libros}"><article class="book-card"><div class="book-index">ID / <c:out value="${libro.idLibro}" /></div><h2><c:out value="${libro.titulo}" /></h2><p class="author"><c:out value="${libro.autor}" /></p><p class="meta"><c:out value="${libro.genero}" /> · <c:out value="${libro.anioPublicacion}" /></p><c:choose><c:when test="${libro.disponible}"><span class="badge available">DISPONIBLE</span></c:when><c:otherwise><span class="badge borrowed">PRESTADO</span></c:otherwise></c:choose><div class="card-actions"><c:choose><c:when test="${libro.disponible and sessionScope.usuarioLogueado.activo}"><form method="post" action="${pageContext.request.contextPath}/app/prestamos"><input type="hidden" name="idLibro" value="${libro.idLibro}"><button class="button button-small" type="submit">SOLICITAR</button></form></c:when><c:when test="${libro.disponible and not sessionScope.usuarioLogueado.activo}"><button class="button button-small btn-disabled" type="button" disabled title="Tu cuenta está desactivada">SOLICITAR</button></c:when></c:choose><c:if test="${sessionScope.usuarioLogueado.rol eq 'BIBLIOTECARIO'}"><a class="text-link" href="${pageContext.request.contextPath}/app/libros?action=editar&id=${libro.idLibro}">Editar</a><form method="post" action="${pageContext.request.contextPath}/app/libros"><input type="hidden" name="action" value="eliminar"><input type="hidden" name="id" value="${libro.idLibro}"><button class="danger-link" type="submit">Eliminar</button></form></c:if></div></article></c:forEach></c:otherwise></c:choose></section></main></body></html>
