<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<nav class="navbar">
	<a class="brand" href="${pageContext.request.contextPath}/app/dashboard">UNTEC <span>//</span> DIGITAL LIBRARY</a>
	<div class="nav-links">
		<a href="${pageContext.request.contextPath}/app/libros">Catálogo</a>
		<a href="${pageContext.request.contextPath}/app/prestamos">Préstamos</a>
		<c:if test="${sessionScope.usuarioLogueado.rol eq 'BIBLIOTECARIO'}">
			<a href="${pageContext.request.contextPath}/app/libros?action=nuevo">Nuevo libro</a>
		</c:if>
		<a class="nav-exit" href="${pageContext.request.contextPath}/logout">Salir</a>
	</div>
</nav>
