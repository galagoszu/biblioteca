<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="es"><head><title>Libro // UNTEC</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="partials/nav.jspf" %><main class="page narrow"><header class="page-header compact"><p class="eyebrow">LIBRARY ADMIN / 03</p><h1><c:choose><c:when test="${empty libro}">Registrar libro</c:when><c:otherwise>Editar libro</c:otherwise></c:choose></h1></header><form class="panel form-grid" method="post" action="${pageContext.request.contextPath}/app/libros"><input type="hidden" name="action" value="${empty libro ? 'crear' : 'actualizar'}"><input type="hidden" name="id" value="${libro.idLibro}"><label>Título<input required name="titulo" value="${libro.titulo}"></label><label>Autor<input required name="autor" value="${libro.autor}"></label><label>ISBN<input name="isbn" value="${libro.isbn}"></label><label>Año<input required type="number" name="anio_publicacion" value="${libro.anioPublicacion}"></label><label>Género<input required name="genero" value="${libro.genero}"></label><div class="form-actions"><button class="button button-primary" type="submit">GUARDAR</button><a class="button" href="${pageContext.request.contextPath}/app/libros">CANCELAR</a></div></form></main></body></html>
