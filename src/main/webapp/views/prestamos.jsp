<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="es"><head><title>Préstamos // UNTEC</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@ include file="partials/nav.jspf" %><main class="page"><header class="page-header compact"><p class="eyebrow">LOAN NETWORK / 04</p><h1>Préstamos</h1></header><c:if test="${param.ok eq 'loan'}"><div class="alert success">Préstamo registrado. Disfruta tu lectura.</div></c:if><c:if test="${param.ok eq 'returned'}"><div class="alert success">Devolución registrada correctamente.</div></c:if><c:if test="${param.error eq 'unavailable'}"><div class="alert error">Ese libro ya no está disponible.</div></c:if><section class="panel table-wrap"><c:choose><c:when test="${empty prestamos}"><p class="empty">No hay préstamos registrados.</p></c:when><c:otherwise><table><thead><tr><th>Libro</th><th>Usuario</th><th>Retiro</th><th>Devolución</th><th>Estado</th><th></th></tr></thead><tbody><c:forEach var="p" items="${prestamos}"><tr><td><strong><c:out value="${p.tituloLibro}" /></strong></td><td><c:out value="${p.nombreUsuario}" /></td><td><c:out value="${p.fechaPrestamo}" /></td><td><c:out value="${p.fechaDevolucion}" /></td><td><c:choose><c:when test="${empty p.fechaDevolucion}"><span class="badge borrowed">ACTIVO</span></c:when><c:otherwise><span class="badge available">CERRADO</span></c:otherwise></c:choose></td><td><c:if test="${empty p.fechaDevolucion}"><form method="post" action="${pageContext.request.contextPath}/app/devolucion"><input type="hidden" name="idPrestamo" value="${p.idPrestamo}"><button class="button button-small" type="submit">DEVOLVER</button></form></c:if></td></tr></c:forEach></tbody></table></c:otherwise></c:choose></section></main></body></html>
